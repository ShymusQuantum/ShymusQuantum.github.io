---
import Base from '../layouts/Base.astro';
import { UI, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = UI[lang];
const email = 'shymus.quantum@outlook.fr';
---
<Base lang={lang} title={t.aboutTitle} dim={0.6}>
  <div class="container">
    <div class="page-panel prose">
      <h1 class="page-title">{t.aboutTitle}</h1>
      <p><a href={`mailto:${email}`}>{email}</a></p>
    </div>
  </div>
</Base>
