---
import Post from '../../views/Post.astro';
import { getPosts, postSlug } from '../../site';
export async function getStaticPaths() {
  const posts = await getPosts('fr');
  return posts.map((post) => ({ params: { slug: postSlug(post.id) }, props: { post } }));
}
---
<Post lang="fr" post={Astro.props.post} />
