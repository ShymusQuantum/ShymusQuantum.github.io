---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, getPosts } from '../site';

const posts = await getPosts();
const featured = posts.filter((p) => p.data.featured);
const latest = [...featured, ...posts.filter((p) => !p.data.featured)].slice(0, 4);
---
<Base>
  <section class="hero container">
    <p class="hello">// salut, moi c'est {SITE.author}.</p>
    <h1>cybersécurité, ondes radio &amp; satellites.</h1>
    <p class="bio">
      Je documente ici mes recherches : réception et décodage de signaux satellites, radio logicielle,
      sécurité des systèmes spatiaux, CTF et tout ce qui m'empêche de dormir la nuit.
    </p>
    <div class="links">
      <a href="/posts/">lire les articles →</a>
      <a href="/about/">qui suis-je →</a>
    </div>
    <div class="telemetry" aria-hidden="true">
      <span class="live">station sol</span>
      <span>az <b id="t-az">---.-</b>°</span>
      <span>él <b id="t-el">--.-</b>°</span>
      <span id="t-mode">balayage</span>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>écrits</h2>
      <p>récents &amp; choisis</p>
    </div>
    <div class="posts">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
    <p style="margin-top:18px"><a class="more" href="/posts/">tous les articles ({posts.length}) →</a></p>
  </section>
</Base>

<script>
  const az = document.getElementById('t-az');
  const el = document.getElementById('t-el');
  const mode = document.getElementById('t-mode');
  window.addEventListener('sky:telemetry', (e) => {
    const d = (e as CustomEvent).detail;
    if (az) az.textContent = d.az.toFixed(1).padStart(5, '0');
    if (el) el.textContent = d.el.toFixed(1).padStart(4, '0');
    if (mode) mode.textContent = d.tracking ? `poursuite ${d.id}` : 'balayage';
  });
</script>
