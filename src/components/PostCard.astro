---
import { formatDate, readingTime, postSlug } from '../site';
import { UI, href, type Lang } from '../i18n';
interface Props { post: any; lang: Lang }
const { post, lang } = Astro.props;
const d = post.data;
---
<a class:list={['card', { noimg: !d.image }]} href={href(lang, `/posts/${postSlug(post.id)}/`)}>
  {d.image && <div class="thumb"><img src={d.image} alt={d.imageAlt ?? ''} loading="lazy" /></div>}
  <div class="body">
    <span class="cat">{d.kind === 'writeup' ? 'writeup · ' : ''}{d.category}</span>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <div class="meta">
      <time datetime={d.date.toISOString()}>{formatDate(d.date, lang)}</time>
      <span>{readingTime(post.body)} {UI[lang].minRead}</span>
    </div>
  </div>
</a>
